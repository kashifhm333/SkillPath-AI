{
  "name": "skillpath-ai-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "SkillPath AI - Personalized Adaptive Learning Roadmap Platform",
  "scripts": {
    "dev": "concurrently -n \"backend,frontend\" -c \"cyan,magenta\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm --prefix app/backend run dev",
    "dev:frontend": "npm --prefix app/frontend run dev",
    "build:backend": "npm --prefix app/backend run build",
    "build:frontend": "npm --prefix app/frontend run build",
    "build": "npm run build:backend && npm run build:frontend",
    "test:backend": "npm --prefix app/backend test",
    "test": "npm run test:backend",
    "docker:up": "docker-compose up --build -d",
    "docker:down": "docker-compose down",
    "capture:screenshots": "node scripts/capture-screenshots.mjs"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "puppeteer-core": "^24.4.0"
  }
}
